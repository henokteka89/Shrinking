USE DBUtils;
GO

DECLARE @LogicalName sysname = 'DBUtils';
DECLARE @TargetSizeMB int = 10240; -- 10 GB
DECLARE @CurrentSizeMB int;
DECLARE @sql nvarchar(4000);

SELECT @CurrentSizeMB = size / 128
FROM sys.database_files
WHERE name = @LogicalName;

SELECT @CurrentSizeMB;

WHILE @CurrentSizeMB > @TargetSizeMB
    AND DATEPART(HOUR, GETDATE()) < 21
BEGIN
    SET @CurrentSizeMB =
        CASE
            WHEN @CurrentSizeMB - 10000 < @TargetSizeMB
                THEN @TargetSizeMB
            ELSE @CurrentSizeMB - 10000
        END;

    SET @sql =
        N'DBCC SHRINKFILE ([' + @LogicalName + '], ' +
        CAST(@CurrentSizeMB AS varchar(20)) + N');';

    PRINT CONVERT(varchar(19), GETDATE(), 120) + ' ' + @sql;

    EXEC (@sql);

    WAITFOR DELAY '00:00:01';
END;